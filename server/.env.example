# 留空时使用演示模式。真实模式要求同时设置以下三个变量。
MODEL_API_BASE_URL=
MODEL_API_KEY=
MODEL_API_NAME=

# 阿里云智能语音交互（一句话识别 + 语音合成）。两个都留空时 /api/asr 返回 503，/api/tts 回退浏览器朗读。
NLS_APPKEY=
NLS_TOKEN=
# 发音人，留空使用默认的 xiaoyun（标准女声）。可选值用 scripts/sample_voices.py 试听后挑。
NLS_TTS_VOICE=
# 可选：访问口令。留空表示不校验；填写后 /api/* 必须带 X-Access-Code 或网址参数 k。
# 用隧道把服务暴露到公网时务必设置，否则拿到链接的人都能花你的额度。
ACCESS_CODE=
# 可选调音参数，留空用服务端默认：语速 -500~500（负值更慢）、语调 -500~500、音量 0~100。
NLS_TTS_RATE=
NLS_TTS_PITCH=
NLS_TTS_VOLUME=
